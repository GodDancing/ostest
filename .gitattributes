# Normalize line endings in the repository.
* text=auto eol=lf

# Shell scripts must keep LF endings on every platform.
*.sh text eol=lf

# Windows-only scripts, if added later, keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.gif binary
*.ico binary

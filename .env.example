# Application Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Required ===

# GitHub personal access token (was hardcoded in src/app.py)
GITHUB_TOKEN=your-github-token

# Database connection string (was hardcoded in src/app.py)
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# Application API key (read via os.environ["API_KEY"] in src/app.py)
API_KEY=change-me

# === Optional ===

# Contact / owner email (was hardcoded in src/app.py)
PROJECT_EMAIL=you@your-domain.com

# Working directory (was an absolute home path in src/app.py)
PROJECT_HOME=./workspace
